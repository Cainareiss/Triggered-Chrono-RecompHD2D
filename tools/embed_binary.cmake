#
# A binary file (a font) as a C byte array, for builds with or without Python:
#   cmake -DIN=FILE -DOUT=OUT.h -DNAME=NAME -P embed_binary.cmake
# OUT.h gets `static const unsigned char NAME[]` and `NAME_size`.
cmake_minimum_required(VERSION 3.20)

file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR size "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
# 20 bytes (100 characters) a line (CMake's regex has no {n})
string(REPEAT "0x[0-9a-f][0-9a-f]," 20 line)
string(REGEX REPLACE "(${line})" "\\1\n    " body "${body}")
set(text "/* Generated by tools/embed_binary.cmake: do not edit. */\n#pragma once\n\n")
string(APPEND text "static const unsigned char ${NAME}[] = {\n    ${body}\n};\n")
string(APPEND text "static const unsigned int ${NAME}_size = ${size};\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
