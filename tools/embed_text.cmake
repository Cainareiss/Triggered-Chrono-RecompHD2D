#
# tools/embed_text.py in CMake, for builds without Python (Android):
#   cmake -DOUT=OUT.h -DPREFIX=PREFIX -DFILES="a;b;..." -P embed_text.cmake
# Same output as the Python script apart from the first comment line.
cmake_minimum_required(VERSION 3.20)

set(text "/* Generated by tools/embed_text.cmake: do not edit. */\n#pragma once\n")
foreach(path IN LISTS FILES)
    if(path STREQUAL "")
        continue()
    endif()
    get_filename_component(base "${path}" NAME)
    string(REGEX REPLACE "[^A-Za-z0-9]" "_" name "${base}")
    file(READ "${path}" body)
    string(REPLACE "\\" "\\\\" body "${body}")
    string(REPLACE "\"" "\\\"" body "${body}")
    if(body STREQUAL "")
        set(lit "    \"\"")
    else()
        set(tail "")
        if(body MATCHES "\n$")
            string(REGEX REPLACE "\n$" "" body "${body}")
            set(tail "\\n")
        endif()
        string(REPLACE "\n" "\\n\"\n    \"" body "${body}")
        set(lit "    \"${body}${tail}\"")
    endif()
    string(APPEND text "\nstatic const char ${PREFIX}_${name}[] =\n${lit};\n")
endforeach()
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL text)
        return()   # unchanged: keep the timestamp, skip rebuilds
    endif()
endif()
file(WRITE "${OUT}" "${text}")
