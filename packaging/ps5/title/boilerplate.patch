@@ -142,6 +143,9 @@ std::uint64_t read_u64(std::span<const std::uint8_t> data, std::size_t at)
 void copy_bytes(std::span<std::uint8_t> target, std::uint64_t at,
                 std::span<const std::uint8_t> source)
 {
+    if (!(at <= target.size() && source.size() <= target.size() - at))
+        std::fprintf(stderr, "copy_bytes: at=0x%llx size=0x%zx target=0x%zx\n",
+                     (unsigned long long)at, source.size(), target.size());
     require(at <= target.size() && source.size() <= target.size() - at, "copy outside output");
     std::copy(source.begin(), source.end(), target.begin() + at);
 }
